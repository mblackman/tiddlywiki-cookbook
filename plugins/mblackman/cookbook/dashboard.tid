title: $:/plugins/mblackman/cookbook/dashboard
caption: Kitchen Cookbook & Cook Log
type: text/vnd.tiddlywiki

\import [[$:/plugins/mblackman/cookbook/procedures]]

\procedure recipe-Filter-Row(recTitle)
<$tiddler tiddler=<<recTitle>>>
<tr>
  <th scope="row"><strong><$link to=<<recTitle>>><<recTitle>></$link></strong></th>
  <td><%if [{!!dish-type}!is[blank]] %><span class="suite-badge suite-badge--accent">{{!!dish-type}}</span><%else%>—<%endif%></td>
  <td><%if [{!!cuisine}!is[blank]] %>{{!!cuisine}}<%else%>—<%endif%></td>
  <td><%if [{!!status}!is[blank]] %><span class={{{ [[suite-badge]] [{!!status}match[Staple]then[suite-badge--success]] [{!!status}match[Tested]then[suite-badge--info]] +[join[ ]] }}}>{{!!status}}</span><%else%>—<%endif%></td>
  <td class="suite-tabular-nums"><%if [{!!rating}!is[blank]] %><span class="suite-badge suite-badge--warning suite-tabular-nums">★ {{!!rating}}/5</span><%else%>—<%endif%></td>
  <td class="suite-tabular-nums"><$text text={{{ [tag[CookLog]field:recipe<recTitle>count[]] }}}/>×</td>
  <td class="suite-tabular-nums"><$text text={{{ [tag[CookLog]field:recipe<recTitle>!sort[cook-date]first[]get[cook-date]else[—]] }}}/></td>
</tr>
</$tiddler>
\end

<div class="tw-recipe-dashboard tw-recipe-container suite-container">
  <div class="tw-recipe-dashboard-header suite-toolbar">
    <$button class="suite-btn suite-btn--primary tw-recipe-btn tw-recipe-btn-primary" actions=<<action-Create-Recipe>>>
      + Create New Recipe
    </$button>
  </div>
  <h3 id="cookbook-recipes-heading" class="tw-recipe-section-title">Filter Recipes</h3>
  <$let
    filterState="$:/temp/recipe/dashboard-filter"
    selType={{{ [<filterState>get[dish-type]] }}}
    selStatus={{{ [<filterState>get[status]] }}}
    selQuery={{{ [<filterState>get[search]trim[]] }}}
  >
    <div class="tw-recipe-filter-bar suite-panel-subtle">
      <label class="tw-recipe-field-label">
        <span>Search</span>
        <$edit-text tiddler=<<filterState>> field="search" tag="input" class="suite-input tw-recipe-input" placeholder="Recipe title, ingredient, cuisine..."/>
      </label>
      <label class="tw-recipe-field-label">
        <span>Dish Type</span>
        <$select tiddler=<<filterState>> field="dish-type" default="" class="suite-select tw-recipe-select">
          <option value="">All Types</option>
          <$list filter="[tag[Recipe]each[dish-type]get[dish-type]!is[blank]sort[]]" variable="dt">
            <option value=<<dt>>><<dt>></option>
          </$list>
        </$select>
      </label>
      <label class="tw-recipe-field-label">
        <span>Status</span>
        <$select tiddler=<<filterState>> field="status" default="" class="suite-select tw-recipe-select">
          <option value="">All Statuses</option>
          <option value="To Try">To Try</option>
          <option value="Tested">Tested</option>
          <option value="Staple">Staple</option>
        </$select>
      </label>
      <%if [<selType>!is[blank]] [<selStatus>!is[blank]] [<selQuery>!is[blank]] +[count[]compare:number:gt[0]] %>
        <$button class="suite-btn tw-recipe-btn">
          <$action-deletetiddler $tiddler=<<filterState>>/>
          Clear Filters
        </$button>
      <%endif%>
    </div>
    <div tabindex="0" role="region" aria-labelledby="cookbook-recipes-heading" class="tw-recipe-table-wrap">
      <table class="tw-recipe-table tw-recipe-table--recipes">
        <thead>
          <tr>
            <th scope="col">Recipe</th>
            <th scope="col">Type</th>
            <th scope="col">Cuisine</th>
            <th scope="col">Status</th>
            <th scope="col">Rating</th>
            <th scope="col">Cooked</th>
            <th scope="col">Last Made</th>
          </tr>
        </thead>
        <tbody>
          <$list filter="[tag[Recipe]!has[draft.of]] :filter[f.filter-By-Type<selType>] :filter[f.filter-By-Status<selStatus>] :filter[f.filter-By-Query<selQuery>] +[sort[title]]" variable="rec" emptyMessage="<tr><td colspan='7' class='tw-recipe-table-empty'>No matching recipes found.</td></tr>">
            <<recipe-Filter-Row recTitle=<<rec>>>>
          </$list>
        </tbody>
      </table>
    </div>
  </$let>
  <h3 id="cookbook-logs-heading" class="tw-recipe-section-title tw-recipe-section-title--spaced">Recent Cook Log Sessions</h3>
  <div tabindex="0" role="region" aria-labelledby="cookbook-logs-heading" class="tw-recipe-table-wrap">
    <table class="tw-recipe-table tw-recipe-table--logs">
      <thead>
        <tr>
          <th scope="col">Date</th>
          <th scope="col">Recipe</th>
          <th scope="col">Scale</th>
          <th scope="col">Session Rating</th>
          <th scope="col">Key Tweaks / Next Time Note</th>
        </tr>
      </thead>
      <tbody>
        <$list filter="[tag[CookLog]!has[draft.of]!sort[cook-date]limit[10]]" variable="log" emptyMessage="<tr><td colspan='5' class='tw-recipe-table-empty'>No cook sessions logged yet.</td></tr>">
          <$tiddler tiddler=<<log>>>
            <tr>
              <th scope="row" class="suite-tabular-nums"><$link to=<<log>>>{{!!cook-date}}</$link></th>
              <td><$link to={{!!recipe}}>{{!!recipe}}</$link></td>
              <td class="suite-tabular-nums">{{!!scale-used}}</td>
              <td class="suite-tabular-nums"><span class="suite-badge suite-badge--warning suite-tabular-nums">★ {{!!session-rating}}/5</span></td>
              <td>
                <%if [{!!next-time}!is[blank]] %>
                  <strong>Next time:</strong> {{!!next-time}}
                <%elseif [{!!modifications}!is[blank]] %>
                  {{!!modifications}}
                <%else%>
                  <$text text={{{ [{!!text}splitregexp[\n]first[]] }}}/>
                <%endif%>
              </td>
            </tr>
          </$tiddler>
        </$list>
      </tbody>
    </table>
  </div>
</div>
